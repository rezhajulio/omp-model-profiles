{
  "name": "omp-model-profiles",
  "version": "1.0.0",
  "description": "Dynamic model profile switcher extension for Oh My Pi (OMP)",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "omp": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun build src/index.ts --outdir dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "pi-extension",
    "omp-plugin",
    "model-profiles",
    "llm",
    "ai"
  ],
  "author": "Rezha Julio <contact@rezhajulio.id>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezhajulio/omp-model-profiles.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
